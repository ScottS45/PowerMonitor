<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.17763.0</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>assets\PowerMonitor.ico</ApplicationIcon>
    <AssemblyName>PowerMonitor</AssemblyName>
    <Version>5.4.6</Version>
    <Company>Sheen Consulting International</Company>
    <Authors>Scott Sheen</Authors>
    <Copyright>Copyright © 2026 Scott Sheen</Copyright>
    <Product>Power Monitor</Product>
    <Title>Power Monitor</Title>
    <Description>Laptop battery, power and application energy monitor.</Description>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Diagnostics.Tracing.TraceEvent" Version="3.1.21" />
    <PackageReference Include="System.Management" Version="10.0.2" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.11" />
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.6" />
    <PackageReference Include="Microsoft.Toolkit.Uwp.Notifications" Version="7.1.3" />
  </ItemGroup>
  <ItemGroup><EmbeddedResource Include="assets\PowerMonitor.ico" LogicalName="PowerMonitor.Assets.PowerMonitor.ico" /></ItemGroup>
</Project>